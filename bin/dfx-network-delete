#!/usr/bin/env bash
set -euo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
source "$SOURCE_DIR/snsdemo.bash"

print_help() {
  cat <<-EOF

	Forgets a network:
	* Canister IDs that snsdemo recorded for the network
	* IDs of the neurons that snsdemo recorded for the network.

	The canisters themselves are not touched.

	EOF
}

# Source the clap.bash file ---------------------------------------------------
source "$SOURCE_DIR/clap.bash"
# Define options
clap.define short=n long=network desc="The network to use" variable=DFX_NETWORK default="local"
# Source the output file ----------------------------------------------------------
source "$(clap.build)"

export DFX_NETWORK

IDS_FILE="$(snsdemo_ids_file "$DFX_NETWORK")"
if test -e "$IDS_FILE"; then
  : Back up the canister IDs
  cp "$IDS_FILE" "$IDS_FILE.$(perl -e 'print time()')"
  echo "Deleting the canister IDs for $DFX_NETWORK in $IDS_FILE ..."
  rm "$IDS_FILE"
fi

NETWORK_NAME="$(snsdemo_env_name "$DFX_NETWORK")"
for neurons_file in "$SNSDEMO_STATE_DIR/neurons"/*."$NETWORK_NAME"; do
  if test -e "$neurons_file"; then
    echo "Deleting the neurons in $neurons_file ..."
    rm "$neurons_file"
  fi
done
