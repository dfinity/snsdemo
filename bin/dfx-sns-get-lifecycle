#!/usr/bin/env bash
set -euo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PATH="$SOURCE_DIR:$PATH"
source "$SOURCE_DIR/snsdemo.bash"

print_help() {
  cat <<-EOF

	Get the current lifecycle of the SNS as a descriptive string rather than a
	number.
	EOF
}

declare -A LIFECYCLE_MAP=(
  [1]="pending"
  [2]="open"
  [3]="committed"
  [4]="aborted"
  [5]="adopted"
)

# Source the clap.bash file ---------------------------------------------------
source "$SOURCE_DIR/clap.bash"
# Define options
clap.define short=n long=network desc="The network to use" variable=DFX_NETWORK default="local"
clap.define short=i long=identity desc="The icp-cli identity to use" variable=DFX_IDENTITY default="$(icp identity default)"
# Source the output file ----------------------------------------------------------
source "$(clap.build)"

export DFX_NETWORK
export DFX_IDENTITY

LIFECYCLE_ID="$(snsdemo_call sns_swap get_lifecycle '(record{})' --identity "$DFX_IDENTITY" | idl2json | jq -r '.lifecycle[0]')"

echo "${LIFECYCLE_MAP[$LIFECYCLE_ID]}"
