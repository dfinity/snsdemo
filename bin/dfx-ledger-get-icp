#!/usr/bin/env bash
set -euo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PATH="$SOURCE_DIR:$PATH"
source "$SOURCE_DIR/snsdemo.bash"

print_help() {
  cat <<-EOF

	Gives a user toy ICP, taken from an affluent friar deployed with every local
	testnet.

	On a local network that is the anonymous principal.  On testnets that were
	set up with 'dfx nns install' it is the identity ident-1, which this script
	imports.

	Note: Identities that existed when the local network started were funded by
	      icp-cli, so they have 1,000,000 ICP.

	EOF
}

# Source the clap.bash file ---------------------------------------------------
source "$SOURCE_DIR/clap.bash"
# Define options
clap.define short=i long=icp desc="The amount of ICP to request" variable=AMOUNT default="10"
clap.define short=n long=network desc="The network to use" variable=DFX_NETWORK default="local"
clap.define short=t long=to desc="Top up to the given value, if needed" variable=IF_NEEDED nargs=0 default=""
# Source the output file ----------------------------------------------------------
source "$(clap.build)"

export DFX_NETWORK
ENVIRONMENT="$(snsdemo_env_name "$DFX_NETWORK")"

# Checks whether anything needs to be done
test -z "${IF_NEEDED:-}" || {
  HAVE_ICP="$(icp token balance -e "$ENVIRONMENT" --quiet | tr -d ',_')"
  NEED_ICP="$(awk -vwant="$AMOUNT" -vhave="$HAVE_ICP" 'BEGIN{need=(want - have);if(need<=0){print 0; exit 0}if(need < 1){print 1}else{print need}}')"
  if [[ "$NEED_ICP" == "0" ]]; then
    echo "Balance is already over $AMOUNT"
  else
    echo "Topping up by $NEED_ICP ICP ..."
    dfx-ledger-get-icp --icp "$NEED_ICP" --network "$DFX_NETWORK"
  fi
  exit 0
}

if snsdemo_is_local "$DFX_NETWORK"; then
  FRIAR="anonymous"
else
  dfx-identity-moneybags
  FRIAR="ident-1"
fi

# Transfers funds from the friar to the current identity.
icp token transfer "$AMOUNT" "$(icp identity principal)" --identity "$FRIAR" -e "$ENVIRONMENT"
