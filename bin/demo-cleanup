#!/usr/bin/env bash
set -euo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PATH="$SOURCE_DIR:$PATH"
source "$SOURCE_DIR/snsdemo.bash"

echo "Stopping the local networks"
dfx-network-stop --network local
dfx-network-stop --network bare
echo "Deleting the canister IDs that snsdemo recorded"
snsdemo_forget_ids local
snsdemo_forget_ids bare
