#!/usr/bin/env bash
set -ueo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PATH="$SOURCE_DIR:$PATH"
DFX_NETWORK="${1:-${DFX_NETWORK:-local}}"
NNS_URL="${NNS_URL:-$(dfx-network-provider --network "$DFX_NETWORK")}"
ic-admin --nns-url "$NNS_URL" get-subnet-list | jq -r '. | join("\n")'
