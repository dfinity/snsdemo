#!/usr/bin/env bash
# Original source: https://github.com/dfinity/ckBTC-Minter-Frontend/blob/master/local_deploy.sh
# Via:             https://github.com/dfinity/nns-dapp/blob/main/scripts/ckbtc/deploy-ckbtc
set -euo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PATH="$SOURCE_DIR:$PATH"
source "$SOURCE_DIR/snsdemo.bash"
. "$SOURCE_DIR/versions.bash"

print_help() {
  cat <<-EOF

	Installs ckbtc canisters.

	EOF
}

# Source the clap.bash file ---------------------------------------------------
source "$SOURCE_DIR/clap.bash"
# Define options
clap.define short=n long=network desc="The network to use" variable=DFX_NETWORK default="local"
clap.define short=p long=prefix desc="Prefix for the local canister names" variable=LOCAL_PREFIX default="ckbtc_"
clap.define short=y long=yes desc="Deploy even if there are existing ckbtc canisters." variable=DFX_YES nargs=0
clap.define short=c long=check desc="Check that the canisters are present and correct." variable=DFX_CHECK nargs=0
clap.define short=m long=mode desc="Canister install mode." variable=DFX_MODE default="reinstall"
clap.define long=wasm_dir desc="Where the imported wasm files are" variable=WASM_DIR default="wasms"
# Source the output file ----------------------------------------------------------
source "$(clap.build)"

export DFX_NETWORK

# TODO: Consider using ./bin/dfx-token-deploy for the ledger and index
# canisters. KYT and minter are custom canisters, so they still need to be done
# here.

: Check preconditions. This is always run.
"${SOURCE_DIR}/dfx-ckbtc-import" --check --prefix "$LOCAL_PREFIX" --wasm_dir "$WASM_DIR" || {
  echo "ERROR: ckbtc canister data and files are not all present and correct."
  echo "       Please run:"
  echo "       dfx-ckbtc-import --prefix '$LOCAL_PREFIX' --wasm_dir '$WASM_DIR'"
  echo
  exit 1
} >&2

deploy_ckbtc() {
  # We create some canisters ahead of time because we need to know their IDs
  # before deploying. Remaining canisters will be created when deployed.
  KYT_ID="$(dfx-canister-create --network "$DFX_NETWORK" --name "${LOCAL_PREFIX}kyt")"
  echo "$KYT_ID"
  MINTERID="$(dfx-canister-create --network "$DFX_NETWORK" --name "${LOCAL_PREFIX}minter")"
  echo "$MINTERID"
  LEDGERID="$(dfx-canister-create --network "$DFX_NETWORK" --name "${LOCAL_PREFIX}ledger")"
  echo "$LEDGERID"

  # Note: icp-cli does not know the types of the arguments, so numbers that are
  # not integers need a type annotation.
  install() {
    local name="$1" argument="$2"
    dfx-canister-install --network "$DFX_NETWORK" --name "${LOCAL_PREFIX}${name}" \
      --wasm "$WASM_DIR/${LOCAL_PREFIX}${name}.wasm" --mode "$DFX_MODE" --args "$argument"
  }

  echo "Step 1: deploying kyt canister..."
  DFX_IDENTITY_PRINCIPAL="$(icp identity principal)"
  install kyt "(opt variant {
  InitArg = record {
      btc_network = variant { mainnet };
      check_mode = variant { AcceptAll };
      num_subnet_nodes = 1 : nat16;
  }
})"

  echo "Step 2: deploying minter canister..."
  install minter "(variant {
  Init = record {
       btc_network = variant { Mainnet };
       ledger_id = principal \"$LEDGERID\";
       ecdsa_key_name = \"key_1\";
       retrieve_btc_min_amount = 13_333 : nat64;
       max_time_in_queue_nanos = 10_000_000_000 : nat64;
       min_confirmations = opt (12 : nat32);
       mode = variant { GeneralAvailability };
       kyt_fee = opt (13_333 : nat64);
       btc_checker_principal = opt principal \"$KYT_ID\";
   }
})"

  echo "Step 3: deploying ledger canister..."
  install ledger "(variant {
  Init = record {
     token_symbol = \"ckBTC\";
     token_name = \"ckBTC\";
     minting_account = record { owner = principal \"$MINTERID\" };
     transfer_fee = 10 : nat;
     max_memo_length = opt (64 : nat16);
     metadata = vec {};
     initial_balances = vec { record { record { owner = principal \"$DFX_IDENTITY_PRINCIPAL\"; }; 10_000_000 : nat; }; };
     archive_options = record {
         num_blocks_to_archive = 10_000 : nat64;
         trigger_threshold = 20_000 : nat64;
         controller_id = principal \"$DFX_IDENTITY_PRINCIPAL\";
         cycles_for_archive_creation = opt (4_000_000_000_000 : nat64);
     };
     feature_flags = opt record {
         icrc2 = true;
         icrc152 = false;
     };
 }
})"

  echo "Step 4: deploying index canister..."
  install index "(opt variant { Init = record { ledger_id = principal \"$LEDGERID\" } })"

  # Example to mint ckBTC

  # BTCADDRESS="$(snsdemo_call "${LOCAL_PREFIX}minter" get_btc_address '(record {subaccount=null;})')"
  # snsdemo_call "${LOCAL_PREFIX}minter" update_balance '(record {subaccount=null;})'
  # WITHDRAWALADDRESS="$(snsdemo_call "${LOCAL_PREFIX}minter" get_withdrawal_account)"
  # echo $BTCADDRESS
  # echo $WITHDRAWALADDRESS
  #
  # cleaned_output=$(echo $WITHDRAWALADDRESS | sed -re 's/^\(|, \)$//g')
  #
  # snsdemo_call "${LOCAL_PREFIX}ledger" icrc1_transfer "(record {from=null; to=$cleaned_output; amount=1000000; fee=null; memo=null; created_at_time=null;})"
  #
  # Execute the command to get the input string and save the result
  # snsdemo_call "${LOCAL_PREFIX}minter" retrieve_btc '(record {fee = null; address="bcrt1qu9za0uzzd3kjjecgv7waqq0ynn8dl8l538q0xl"; amount=10000})'

  echo "Step 5: transfer ckBTC to principal..."
  # record { owner= principal “”;}
  snsdemo_call "${LOCAL_PREFIX}ledger" icrc1_transfer "(record {from=null; to=record { owner= principal \"73avq-yvrvj-kuzxq-kttlj-nkaz4-tecy6-biuud-3ymeg-guvci-naire-uqe\";}; amount=1000000 : nat; fee=null; memo=null; created_at_time=null;})"
}

check_ckbtc_deployment() {
  for canister in kyt ledger minter index; do
    : "Verify that the deployed canister matches the local wasm"
    dfx-canister-check-wasm-hash --canister "${LOCAL_PREFIX}$canister" --wasm "$WASM_DIR/${LOCAL_PREFIX}$canister.wasm" --network "$DFX_NETWORK"
  done
}

[[ "${DFX_CHECK:-}" == "true" ]] || deploy_ckbtc
check_ckbtc_deployment
