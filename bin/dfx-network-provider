#!/usr/bin/env bash
set -euo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
source "$SOURCE_DIR/snsdemo.bash"

print_help() {
  cat <<-EOF

	Provides the address of a server that can be used for NNS proposals.

	EOF
}

# Source the clap.bash file ---------------------------------------------------
source "$SOURCE_DIR/clap.bash"
# Define options
clap.define short=n long=network desc="The network to use" variable=DFX_NETWORK default="local"
clap.define short=f long=format desc="The format: url or ip" variable=FORMAT default="url"
# Source the output file ----------------------------------------------------------
source "$(clap.build)"

export DFX_NETWORK

case "${FORMAT}" in
url)
  if snsdemo_is_local "$DFX_NETWORK"; then
    echo "http://localhost:$(snsdemo_gateway_port "$DFX_NETWORK")"
  elif [[ "$(snsdemo_env_name "$DFX_NETWORK")" == "ic" ]]; then
    echo "https://ic0.app"
  else
    snsdemo_api_url "$DFX_NETWORK"
  fi
  ;;
ip)
  if snsdemo_is_local "$DFX_NETWORK"; then
    echo localhost
  else
    # The host of the URL, without the brackets of an IPv6 address.
    snsdemo_api_url "$DFX_NETWORK" | sed -E 's,^[a-z]+://,,;s,/.*,,;s,:[0-9]+$,,;s/.*\[//g;s/\].*//g'
  fi
  ;;
*)
  echo "ERROR: Unsupported format '$FORMAT'" >&2
  exit 1
  ;;
esac
