#!/usr/bin/env bash
set -euo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PATH="$SOURCE_DIR:$PATH"
source "$SOURCE_DIR/snsdemo.bash"

(
  printf "\n\n===================================\n"
  echo "Should fail if ckbtc canisters have not been imported"
  error_log="$(mktemp ,test_log.XXXXXXXX)"
  if dfx-ckbtc-deploy --network bare --check 2>"$error_log"; then
    echo "ERROR: Should fail if ckbtc canisters are not imported"
    exit 1
  fi
  grep 'ckbtc canister data and files are not all present and correct' "$error_log" || {
    echo "The check should complain about ckbtc canisters missing"
    exit 1
  }
  rm "$error_log"
)
(
  printf "\n\n===================================\n"
  echo "Should fail if ckbtc canisters have not been created"
  snsdemo_test_network_start
  dfx-ckbtc-import
  error_log="$(mktemp ,test_log.XXXXXXXX)"
  if dfx-ckbtc-deploy --network bare --check 2>"$error_log"; then
    echo "ERROR: Should fail if ckbtc canisters are not imported"
  fi
  grep 'Cannot find canister id' "$error_log" || {
    echo "The check should complain about missing canisters:"
    echo "Actual error log:"
    cat "$error_log"
    exit 1
  }
  rm "$error_log"
  dfx-network-stop --network bare
)
(
  printf "\n\n===================================\n"
  echo "Should fail if ckbtc canisters have not been populated"
  snsdemo_test_network_start
  dfx-ckbtc-import
  dfx-canister-create --network bare --name ckbtc_kyt
  dfx-canister-create --network bare --name ckbtc_ledger
  dfx-canister-create --network bare --name ckbtc_minter
  error_log="$(mktemp ,test_log.XXXXXXXX)"
  if dfx-ckbtc-deploy --network bare --check 2>"$error_log"; then
    echo "ERROR: Should fail if ckbtc canisters have the incorrect or no hash"
  fi
  grep 'ERROR: Deployed ckbtc_kyt hash does not match.' "$error_log" || {
    echo "ERROR: The check should complain about missing canisters."
    echo "Actual error output:"
    sed 's/^/    /g' "$error_log"
    exit 1
  }
  rm "$error_log"
  dfx-network-stop --network bare
)
(
  printf "\n\n===================================\n"
  echo "Should succeed if canisters have been deployed"
  snsdemo_test_network_start
  dfx-ckbtc-import
  dfx-ckbtc-deploy --network bare --yes
  dfx-ckbtc-deploy --network bare --check
  dfx-network-stop --network bare
)

printf "\n\n\nckbtc tests passed.\n"
