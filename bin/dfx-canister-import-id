#!/usr/bin/env bash
set -euo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PATH="$SOURCE_DIR:$PATH"
source "$SOURCE_DIR/snsdemo.bash"

print_help() {
  cat <<-EOF

	Imports the ID of a canister from another snsdemo state directory.

	Example:
	 * Suppose that you have deployed canisters with the snsdemo scripts in a
	   directory ~/dfx/snsdemo/ to a local network.
	 * Suppose also that you are working on another project that needs to know
	   the IDs of some of the same canisters.
	 * Run: dfx-canister-import-id --from ~/dfx/snsdemo/ nns-dapp
	 * Now "dfx-canister-id nns-dapp" will give the same result in both places.
	EOF
}

# Source the clap.bash file ---------------------------------------------------
source "$SOURCE_DIR/clap.bash"
# Define options
clap.define short=n long=network desc="The network to use" variable=DFX_NETWORK default="local"
clap.define short=c long=canister_name desc="The name of the canister" variable=DFX_CANISTER_NAME
clap.define short=f long=from desc="The directory of the snsdemo project to get the ID from." variable=DFX_SOURCE
clap.define short=a long=all desc="Gets all available canisters" variable=DFX_ALL nargs=0
# Source the output file ----------------------------------------------------------
source "$(clap.build)"

SOURCE_IDS_FILE="$DFX_SOURCE/.snsdemo/canister_ids/$(snsdemo_env_name "$DFX_NETWORK").json"
test -s "$SOURCE_IDS_FILE" || snsdemo_die "No canister IDs found in '$SOURCE_IDS_FILE'."

if test -z "${DFX_ALL:-}"; then
  DFX_CANISTER_NAME="${DFX_CANISTER_NAME:-$1}"
  ID="$(jq -er --arg name "$DFX_CANISTER_NAME" '.[$name]' "$SOURCE_IDS_FILE")"
  snsdemo_set_canister_id "$DFX_CANISTER_NAME" "$ID" "$DFX_NETWORK"
else
  jq -r 'keys[]' "$SOURCE_IDS_FILE" | while read -r name; do
    snsdemo_set_canister_id "$name" "$(jq -er --arg name "$name" '.[$name]' "$SOURCE_IDS_FILE")" "$DFX_NETWORK"
  done
fi
