#!/usr/bin/env bash
set -euo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PATH="$SOURCE_DIR:$PATH"
source "$SOURCE_DIR/snsdemo.bash"

print_help() {
  cat <<-EOF

	Records the IDs of the NNS canisters of a network, so that they can be used
	by name, for example:

	  dfx-canister-id --network local nns-governance

	The canisters have the same IDs on the IC mainnet and in the local network
	that PocketIC provides.  Candid interfaces are not imported: icp-cli reads
	them from the metadata of the canisters.

	Names: nns-registry nns-governance nns-ledger nns-root nns-cycles-minting
	nns-lifeline nns-genesis-token nns-sns-wasm nns-icp-index nns-cycles-ledger
	nns-dapp (also known as nns-ui) internet_identity (also known as
	nns-identity) internet_identity_frontend sns_aggregator
	EOF
}

# Source the clap.bash file ---------------------------------------------------
source "$SOURCE_DIR/clap.bash"
# Define options
clap.define short=n long=network desc="The network to use" variable=DFX_NETWORK default="local"
# Source the output file ----------------------------------------------------------
source "$(clap.build)"

export DFX_NETWORK

for name in nns-registry nns-governance nns-ledger nns-root nns-cycles-minting nns-lifeline nns-genesis-token nns-sns-wasm nns-icp-index nns-cycles-ledger nns-dapp nns-ui internet_identity nns-identity internet_identity_frontend sns_aggregator; do
  snsdemo_set_canister_id "$name" "$(snsdemo_well_known_canister_id "$name")" "$DFX_NETWORK"
done
