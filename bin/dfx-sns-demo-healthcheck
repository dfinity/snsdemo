#!/usr/bin/env bash
set -ueo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PATH="$SOURCE_DIR:$PATH"
source "$SOURCE_DIR/snsdemo.bash"

# Source the clap.bash file ---------------------------------------------------
source "$SOURCE_DIR/clap.bash"
# Define options
clap.define short=n long=network desc="The network to use" variable=DFX_NETWORK default="local"
clap.define short=t long=timeout desc="The maximum number of seconds to wait" variable=TIMEOUT default=300
# Source the output file ----------------------------------------------------------
source "$(clap.build)"

export DFX_NETWORK

is_healthy() {
  for canister in nns-governance nns-sns-wasm sns_aggregator nns-dapp internet_identity; do
    if ! snsdemo_module_hash "$canister" | grep -q '^0x'; then
      echo "No module found in $canister."
      return 1
    fi
  done
}

SLEEP_TIME=5
for ((countdown = TIMEOUT; countdown >= 0; countdown -= SLEEP_TIME)); do
  if is_healthy; then
    break
  fi
  printf 'Not healthy yet. Time remaining: % 8d seconds\n' "$countdown"
  sleep "$SLEEP_TIME"
done

echo Basic health check passes
