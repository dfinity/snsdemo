#!/usr/bin/env bash
set -euxo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PATH="$SOURCE_DIR:$PATH"

nns_canisters=(nns-registry nns-governance nns-ledger nns-root nns-cycles-minting nns-lifeline nns-genesis-token nns-sns-wasm nns-icp-index internet_identity nns-dapp sns_aggregator) # Omitted: nns-identity nns-ui nns-ic-ckbtc-minter
networks=(ic local)

(
  printf "\n=====================================\n\n"
  echo "dfx-nns-import records the NNS canister IDs"
  export SNSDEMO_STATE_DIR
  SNSDEMO_STATE_DIR="$(mktemp -d)"
  trap 'rm -fr "$SNSDEMO_STATE_DIR"' EXIT
  for DFX_NETWORK in "${networks[@]}"; do
    dfx-nns-import --network "$DFX_NETWORK"
    for canister in "${nns_canisters[@]}"; do
      dfx-canister-id --network "$DFX_NETWORK" "$canister" >/dev/null || {
        echo "ERROR: Did not import canister ID for $canister on network $DFX_NETWORK"
        exit 1
      }
    done
  done
  [[ "$(dfx-canister-id --network local nns-governance)" == "rrkah-fqaaa-aaaaa-aaaaq-cai" ]] || {
    echo "ERROR: Unexpected ID for the NNS governance canister"
    exit 1
  }
  echo "Check passed"
)
