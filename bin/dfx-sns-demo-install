#!/usr/bin/env bash
set -euo pipefail

SOURCE_DIR="$(dirname "${BASH_SOURCE[0]}")"
PATH="$SOURCE_DIR:$PATH"

print_help() {
  cat <<-EOF
	Installs the binaries needed for the SNS demo.
	mise installs the tools in mise.toml.
	EOF
}

set +e
# Source the clap.bash file ---------------------------------------------------
source "$SOURCE_DIR/clap.bash"
# Define options
# Source the output file ----------------------------------------------------------
source "$(clap.build)"
set -e

# The tools in mise.toml: icp-cli, the network launcher, quill, idl2json, didc and ic-wasm.
if command -v mise >/dev/null; then
  mise install
else
  echo "mise is not installed.  Please install it, see https://mise.jdx.dev, and run 'mise install'." >&2
  exit 1
fi

# Tools that are not in mise.toml
dfx-software-jq-install
dfx-software-more-install
dfx-software-openssl-install

# These come from a specific commit of the IC repo.
dfx-software-ic-install-executable ic-admin sns
