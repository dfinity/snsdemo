#!/usr/bin/env bash
set -euo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PATH="$SOURCE_DIR:$PATH"
source "$SOURCE_DIR/snsdemo.bash"

print_help() {
  cat <<-EOF

	Import SNS canister IDs for the SNS created with the given proposal ID as known canisters.
	EOF
}

# Source the clap.bash file ---------------------------------------------------
source "$SOURCE_DIR/clap.bash"
# Define options
clap.define short=p long=proposal_id desc="The ID of the SNS proposal" variable=PROPOSAL_ID
clap.define short=n long=network desc="The network to use" variable=DFX_NETWORK default="local"
# Source the output file ----------------------------------------------------------
source "$(clap.build)"

if [[ -z "${PROPOSAL_ID:-}" ]]; then
  echo "Please specify --proposal_id"
  exit 1
fi

try_import() {
  local RESPONSE_JSON ERROR_MESSAGE

  RESPONSE_JSON="$(snsdemo_call nns-sns-wasm get_deployed_sns_by_proposal_id "(record {proposal_id = $PROPOSAL_ID:nat64})" | idl2json)"

  ERROR_MESSAGE="$(jq -r '.get_deployed_sns_by_proposal_id_result[0].Error.message' <<<"$RESPONSE_JSON")"

  if [[ "$ERROR_MESSAGE" != "null" ]]; then
    echo "Error: $ERROR_MESSAGE" >&2
    return 1
  fi

  : Fetch SNS canister IDs and record them
  local IDS
  IDS="$(jq -e '.get_deployed_sns_by_proposal_id_result[0].DeployedSns |
    {
      sns_governance: .governance_canister_id[0],
      sns_index: .index_canister_id[0],
      sns_ledger: .ledger_canister_id[0],
      sns_root: .root_canister_id[0],
      sns_swap: .swap_canister_id[0]
    } | to_entries | map("\(.key) \(.value)") | .[]' -r <<<"$RESPONSE_JSON")"
  while read -r name id; do
    snsdemo_set_canister_id "$name" "$id"
  done <<<"$IDS"

  echo "Successfully imported SNS canisters for proposal $PROPOSAL_ID"
}

SUCCESS=false

for ((try = 20; try > 0; try--)); do
  if try_import; then
    SUCCESS=true
    break
  fi
  echo -n "Trying $try more times... "
  sleep 2
done

if [[ "$SUCCESS" = "false" ]]; then
  echo "Failed to import SNS canisters for proposal $PROPOSAL_ID" >&2
  exit 1
fi
