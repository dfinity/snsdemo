#!/usr/bin/env bash
set -euo pipefail
SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PATH="$SOURCE_DIR:$PATH"
source "$SOURCE_DIR/snsdemo.bash"
. "$SOURCE_DIR/versions.bash"

print_help() {
  cat <<-EOF

	Downloads the wasm and candid files of the ckbtc canisters.

	EOF
}

# Source the clap.bash file ---------------------------------------------------
source "$SOURCE_DIR/clap.bash"
# Define options
clap.define short=c long=commit desc="Commit of the IC repo to download canisters from" variable=DFX_IC_COMMIT default="$DFX_IC_COMMIT"
clap.define short=p long=prefix desc="Prefix for the local canister names" variable=LOCAL_PREFIX default="ckbtc_"
clap.define long=check desc="Check whether the canisters have been imported" variable=DFX_CHECK nargs=0
clap.define long=wasm_dir desc="Where to store the imported wasm files" variable=WASM_DIR default="wasms"
clap.define long=candid_dir desc="Where to store the imported candid files" variable=CANDID_DIR default="candid"
# Source the output file ----------------------------------------------------------
source "$(clap.build)"

# TODO: Consider using ./bin/dfx-token-import for the ledger and index
# canisters. KYT and minter are custom canisters, so they still need to be done
# here.

CKBTC_CANISTERS=(kyt minter ledger index)

# Imports wasm and candid files.
ckbtc_import() {
  : Get the wasms
  snsdemo_download_wasm "$DFX_IC_COMMIT" ic-btc-checker.wasm "$WASM_DIR/${LOCAL_PREFIX}kyt.wasm"
  snsdemo_download_wasm "$DFX_IC_COMMIT" ic-ckbtc-minter.wasm "$WASM_DIR/${LOCAL_PREFIX}minter.wasm"
  snsdemo_download_wasm "$DFX_IC_COMMIT" ic-icrc1-ledger.wasm "$WASM_DIR/${LOCAL_PREFIX}ledger.wasm"
  snsdemo_download_wasm "$DFX_IC_COMMIT" ic-icrc1-index-ng.wasm "$WASM_DIR/${LOCAL_PREFIX}index.wasm"

  : Get the candid files
  snsdemo_download_did "$DFX_IC_COMMIT" rs/bitcoin/checker/btc_checker_canister.did "$CANDID_DIR/${LOCAL_PREFIX}kyt.did"
  snsdemo_download_did "$DFX_IC_COMMIT" rs/bitcoin/ckbtc/minter/ckbtc_minter.did "$CANDID_DIR/${LOCAL_PREFIX}minter.did"
  snsdemo_download_did "$DFX_IC_COMMIT" rs/ledger_suite/icrc1/ledger/ledger.did "$CANDID_DIR/${LOCAL_PREFIX}ledger.did"
  snsdemo_download_did "$DFX_IC_COMMIT" rs/ledger_suite/icrc1/index-ng/index-ng.did "$CANDID_DIR/${LOCAL_PREFIX}index.did"

  : "Ckbtc canister import complete."
}

# Checks whether ckbtc canisters have already been imported.
ckbtc_import_check() {
  snsdemo_check_imported "$WASM_DIR" "$CANDID_DIR" "$LOCAL_PREFIX" "${CKBTC_CANISTERS[@]}"
}

###########
# M A I N #
###########
if [[ "${DFX_CHECK:-}" == "true" ]]; then
  ckbtc_import_check
else
  ckbtc_import
fi
